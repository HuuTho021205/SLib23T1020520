@model SLib23T1020520.Models.Entities.Language

@{
    ViewBag.Title = Model.LanguageId == 0 ? "Bổ sung ngôn ngữ mới" : "Cập nhật thông tin ngôn ngữ";
}

<div class="card card-primary card-outline mb-4">

    <!-- Tiêu đề -->
    <div class="card-header">
        <h3 class="card-title">Thông tin ngôn ngữ</h3>
    </div>

    <!-- Form nhập liệu -->
    <form action="~/Language/SaveData" method="post">

        <div class="card-body">
            <input type="hidden" asp-for="LanguageId" />

            <!-- Mã viết tắt ngôn ngữ -->
            <div class="mb-3">
                <label for="LanguageCode" class="form-label">
                    Mã ngôn ngữ <span class="text-danger">*</span>
                </label>
                <input type="text"
                       asp-for="LanguageCode"
                       class="form-control"
                       maxlength="10"
                       placeholder="Ví dụ: VIE, ENG, JPN..." autofocus
                       required />
            </div>

            <!-- Tên ngôn ngữ -->
            <div class="mb-3">
                <label for="LanguageName" class="form-label">
                    Tên ngôn ngữ <span class="text-danger">*</span>
                </label>
                <input type="text"
                       asp-for="LanguageName"
                       class="form-control"
                       placeholder="Nhập tên đầy đủ của ngôn ngữ..."
                       required />
            </div>

            <!-- Trạng thái sử dụng -->
            <div class="mb-3">
                <label for="IsActive" class="form-label">
                    Trạng thái sử dụng
                </label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Đang sử dụng</option>
                    <option value="false">Ngừng sử dụng</option>
                </select>
            </div>
        </div>

        <!-- Các nút chức năng -->
        <div class="card-footer">
            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Lưu
                </button>

                <a href="~/Language/Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Bỏ qua
                </a>
            </div>
        </div>

    </form>

</div>