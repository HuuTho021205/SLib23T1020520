@model IEnumerable<Publisher>

@{
    ViewBag.Title = "Quản lý nhà xuất bản";
}

<div class="card card-primary card-outline mb-4">

    <!-- Ô tìm kiếm + nút bổ sung -->
    <div class="card-header">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <form action="/Publisher" method="get">
                    <div class="input-group">
                        <input type="text" name="keyword" class="form-control"
                               placeholder="Nhập tên nhà xuất bản cần tìm..." autocomplete="off" />
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                    </div>
                </form>
            </div>
            <div class="col-md-6 text-md-end">
                <a href="/Publisher/Create" class="btn btn-success">
                    <i class="bi bi-plus-lg"></i> Bổ sung
                </a>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách nhà xuất bản -->
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
                <thead class="table-light text-nowrap">
                    <tr>
                        <th class="text-center">Mã</th>
                        <th>Tên nhà xuất bản</th>
                        <th>Địa chỉ trụ sở</th>
                        <th>Số điện thoại</th>
                        <th>Email liên hệ</th>
                        <th>Website</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thời điểm tạo</th>
                        <th class="text-center" style="width: 1%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.PublisherId</td>
                            <td>@item.PublisherName</td>
                            <td>@item.Address</td>
                            <td>@item.Phone</td>
                            <td>@item.Email</td>
                            <td>@item.Website</td>
                            <td class="text-center text-nowrap">
                                @if (item.IsActive)
                                {
                                    <span class="badge text-bg-success">Đang sử dụng</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Ngừng sử dụng</span>
                                }
                            </td>
                            <td class="text-center text-nowrap">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center text-nowrap">
                                <a href="/Publisher/Edit/@item.PublisherId" class="btn btn-sm btn-primary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/Publisher/Delete/@item.PublisherId" class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>