@model IEnumerable<Category>

@{
    ViewBag.Title = "Quản lý phân loại sách";
}

<div class="card card-primary card-outline mb-4">

    <!-- Ô tìm kiếm + nút bổ sung -->
    <div class="card-header">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <form action="/Category" method="get">
                    <div class="input-group">
                        <input type="text" name="keyword" class="form-control"
                               placeholder="Nhập tên phân loại sách cần tìm..." autocomplete="off" />
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>
                    </div>
                </form>
            </div>
            <div class="col-md-6 text-md-end">
                <a href="/Category/Create" class="btn btn-success">
                    <i class="bi bi-plus-lg"></i> Bổ sung
                </a>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách phân loại sách -->
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
                <thead class="table-light text-nowrap">
                    <tr>
                        <th class="text-center">Mã</th>
                        <th>Tên phân loại</th>
                        <th class="text-center">Mã danh mục cha</th>
                        <th>Mô tả</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 1%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.CategoryId</td>
                            <td>@item.CategoryName</td>
                            <td class="text-center">
                                @(item.ParentCategoryId.HasValue? item.ParentCategoryId.ToString() : "Danh mục gốc")
                            </td>
                            <td>@item.Description</td>
                            <td class="text-center text-nowrap">
                                @if (item.IsActive)
                                {
                                    <span class="badge text-bg-success">Đang sử dụng</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Ngừng sử dụng</span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <a href="/Category/Edit/@item.CategoryId" class="btn btn-sm btn-primary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/Category/Delete/@item.CategoryId" class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>